{
  "manifest_version": 3,
  "name": "Create Google Event from Selected Text",
  "version": "1.0",
  "description": "Right-click on selected text to create a Google Calendar event.",
  "permissions": [
    "contextMenus",
    "identity",
    "notifications"
  ],
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events"
    ]
  },
  "host_permissions": [
    "https://www.googleapis.com/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Create Google Event"
  }
}
